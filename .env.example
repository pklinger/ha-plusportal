# Copy to .env and fill in. Never commit .env.
# Tenant number from your portal URL: https://123456.plusportal.de -> 123456
PLUSPORTAL_TENANT=123456
# Alternatively the full base URL (takes precedence over PLUSPORTAL_TENANT):
# PLUSPORTAL_BASE_URL=https://123456.plusportal.de

# Portal login — either the e-mail address or the customer number.
PLUSPORTAL_USERNAME=
PLUSPORTAL_PASSWORD=

# Tariff (all optional, needed only for the `cost` command):
# PLUSPORTAL_ENERGY_PRICE_CT=32.5        # energy price in ct/kWh; required by 'cost'
# PLUSPORTAL_BASE_PRICE_EUR=120.00       # annual standing charge in EUR; used by 'cost'
# PLUSPORTAL_MONTHLY_ADVANCE_EUR=85.00   # monthly advance payment in EUR; used by 'cost'
# PLUSPORTAL_BILLING_YEAR_START=01-01    # billing year start as MM-DD; default 01-01
